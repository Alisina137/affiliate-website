generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// CORE MODELS
// ============================================

model Niche {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  image       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categories Category[]
  products   Product[]
  brands     Brand[]
  statistics Statistic[]

  @@map("niches")
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  image       String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parentId String?
  parent   Category?  @relation("CategoryParent", fields: [parentId], references: [id])
  children Category[] @relation("CategoryParent")

  nicheId  String
  niche    Niche     @relation(fields: [nicheId], references: [id], onDelete: Cascade)
  products Product[]
  brands   Brand[]

  bestOf     BestOf[]
  guides     Guide[]
  statistics Statistic[]
  articles   Article[]

  @@unique([nicheId, slug])
  @@map("categories")
}

model Brand {
  id           String   @id @default(cuid())
  name         String   @unique
  slug         String   @unique
  description  String?
  logo         String?
  website      String?
  foundedYear  Int?
  headquarters String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  nicheId    String?
  niche      Niche?     @relation(fields: [nicheId], references: [id])
  products   Product[]
  categories Category[]

  @@map("brands")
}

// ============================================
// PRODUCT MODELS
// ============================================

model Product {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  description      String?  @db.Text
  shortDescription String?  @db.Text
  price            Float?
  currency         String   @default("USD")
  rating           Float?   @default(0)
  reviewCount      Int      @default(0)
  bestFor          String?
  availability     String   @default("IN_STOCK")
  featured         Boolean  @default(false)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  specifications Json?
  features       Json?
  images         String[]

  brandId    String?
  brand      Brand?    @relation(fields: [brandId], references: [id])
  nicheId    String?
  niche      Niche?    @relation(fields: [nicheId], references: [id])
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  affiliateLinks     AffiliateLink[]
  affiliateClicks    AffiliateClick[]
  reviews            Review[]
  comparisonProducts ComparisonProduct[]
  bestOfEntries      BestOfEntry[]
  guideProducts      GuideProduct[]

  @@map("products")
}

// ============================================
// AFFILIATE MODELS
// ============================================

model AffiliateLink {
  id          String    @id @default(cuid())
  url         String    @db.Text
  label       String    @default("Check Price")
  merchant    String
  merchantId  String?
  trackingUrl String?   @db.Text
  country     String    @default("US")
  isActive    Boolean   @default(true)
  priority    Int       @default(0)
  clicks      Int       @default(0)
  lastClicked DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  productId       String
  product         Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  affiliateClicks AffiliateClick[]

  @@map("affiliate_links")
}

model AffiliateProgram {
  id             String   @id @default(cuid())
  name           String   @unique
  slug           String   @unique
  description    String?  @db.Text
  logo           String?
  website        String?
  commission     String?
  cookieDuration Int?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  merchants AffiliateMerchant[]

  @@map("affiliate_programs")
}

model AffiliateMerchant {
  id          String           @id @default(cuid())
  name        String
  slug        String           @unique
  description String?
  logo        String?
  website     String?
  programId   String
  program     AffiliateProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([programId, name])
  @@map("affiliate_merchants")
}

model AffiliateClick {
  id              String        @id @default(cuid())
  affiliateLinkId String
  affiliateLink   AffiliateLink @relation(fields: [affiliateLinkId], references: [id], onDelete: Cascade)
  productId       String?
  product         Product?      @relation(fields: [productId], references: [id])
  userId          String?
  user            User?         @relation(fields: [userId], references: [id])
  ipAddress       String?
  userAgent       String?       @db.Text
  referer         String?       @db.Text
  country         String?
  device          String?
  converted       Boolean       @default(false)
  conversionValue Float?
  createdAt       DateTime      @default(now())

  @@map("affiliate_clicks")
}

// ============================================
// AI MODELS
// ============================================

model AIGeneration {
  id                String             @id @default(cuid())
  userId            String
  user              User               @relation(fields: [userId], references: [id])
  contentType       String // REVIEW, COMPARISON, BEST_OF, GUIDE, STATISTICS, PRODUCT, SEO, FAQ, OUTLINE
  contentId         String? // ID of the content being generated/edited
  operation         String // GENERATE, REGENERATE, IMPROVE, REWRITE, EXPAND, SHORTEN, ANALYZE
  model             String // AI model used (e.g., "gpt-4", "claude-3")
  promptVersion     String? // Version of the prompt used
  input             Json // The input sent to the AI
  output            Json? // The output received from the AI
  status            String             @default("PENDING") // PENDING, SUCCESS, FAILED, PARTIAL
  error             String?            @db.Text
  inputTokens       Int? // Number of tokens in the input
  outputTokens      Int? // Number of tokens in the output
  estimatedCost     Float? // Estimated cost in USD
  duration          Int? // Generation time in milliseconds
  createdAt         DateTime           @default(now())
  aicontentVersions AIContentVersion[]
  aiusages          AIUsage[]

  @@index([userId, contentType, status])
  @@index([createdAt])
  @@map("ai_generations")
}

model AIContentVersion {
  id           String        @id @default(cuid())
  contentId    String // ID of the content (review, article, etc.)
  contentType  String // Type of content (review, article, comparison, etc.)
  version      Int           @default(1)
  data         Json // Full snapshot of the content at this version
  changes      Json? // What changed from previous version
  createdBy    String
  creator      User          @relation(fields: [createdBy], references: [id])
  generationId String? // Reference to the AIGeneration that created this version
  generation   AIGeneration? @relation(fields: [generationId], references: [id])
  isCurrent    Boolean       @default(true)
  changeType   String // MANUAL, AI_GENERATED, AI_IMPROVED, AI_REWRITTEN
  createdAt    DateTime      @default(now())

  @@unique([contentId, contentType, version])
  @@index([contentId, contentType, isCurrent])
  @@map("ai_content_versions")
}

model AIPromptTemplate {
  id           String   @id @default(cuid())
  name         String   @unique
  slug         String   @unique
  description  String?  @db.Text
  contentType  String // REVIEW, COMPARISON, BEST_OF, GUIDE, STATISTICS, PRODUCT, SEO, FAQ, OUTLINE
  operation    String // GENERATE, IMPROVE, REWRITE, EXPAND, SHORTEN, ANALYZE
  systemPrompt String?  @db.Text
  userPrompt   String   @db.Text
  version      Int      @default(1)
  isActive     Boolean  @default(true)
  isDefault    Boolean  @default(false)
  metadata     Json? // Additional metadata (temperature, max_tokens, etc.)
  createdBy    String
  creator      User     @relation(fields: [createdBy], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([name, version])
  @@map("ai_prompt_templates")
}

model AIUsage {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id])
  contentType  String // REVIEW, COMPARISON, BEST_OF, GUIDE, STATISTICS, PRODUCT, SEO, FAQ, OUTLINE
  operation    String // GENERATE, IMPROVE, REWRITE, EXPAND, SHORTEN, ANALYZE
  model        String
  inputTokens  Int
  outputTokens Int
  cost         Float
  duration     Int
  generationId String?
  generation   AIGeneration? @relation(fields: [generationId], references: [id])
  createdAt    DateTime      @default(now())

  @@index([userId, contentType])
  @@index([createdAt])
  @@map("ai_usage")
}

// ============================================
// REVIEW MODELS
// ============================================

model Review {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  content     String?   @db.Text
  excerpt     String?   @db.Text
  rating      Float?    @default(0)
  pros        String[]  @default([])
  cons        String[]  @default([])
  verdict     String?   @db.Text
  bestFor     String?
  featured    Boolean   @default(false)
  status      String    @default("DRAFT")
  views       Int       @default(0)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  seoTitle        String?
  metaDescription String?

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  contentBlocks Json? @default("[]")

  @@map("reviews")
}

// ============================================
// COMPARISON MODELS
// ============================================

model Comparison {
  id                String    @id @default(cuid())
  title             String
  slug              String    @unique
  content           String?   @db.Text
  excerpt           String?   @db.Text
  winner            String?
  winnerExplanation String?   @db.Text
  featured          Boolean   @default(false)
  status            String    @default("DRAFT")
  views             Int       @default(0)
  publishedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  seoTitle        String?
  metaDescription String?

  products ComparisonProduct[]

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  contentBlocks Json? @default("[]")

  @@map("comparisons")
}

model ComparisonProduct {
  id           String   @id @default(cuid())
  comparisonId String
  productId    String
  strengths    String[] @default([])
  weaknesses   String[] @default([])
  bestFor      String?
  order        Int      @default(0)

  comparison Comparison @relation(fields: [comparisonId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([comparisonId, productId])
  @@map("comparison_products")
}

// ============================================
// BEST-OF MODELS
// ============================================

model BestOf {
  id           String    @id @default(cuid())
  title        String
  slug         String    @unique
  content      String?   @db.Text
  excerpt      String?   @db.Text
  introduction String?   @db.Text
  featured     Boolean   @default(false)
  status       String    @default("DRAFT")
  views        Int       @default(0)
  publishedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  seoTitle        String?
  metaDescription String?

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  entries BestOfEntry[]

  contentBlocks Json? @default("[]")

  @@map("best_of")
}

model BestOfEntry {
  id        String   @id @default(cuid())
  bestOfId  String
  productId String
  order     Int      @default(0)
  bestFor   String?
  summary   String?  @db.Text
  pros      String[] @default([])
  cons      String[] @default([])

  bestOf  BestOf  @relation(fields: [bestOfId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([bestOfId, productId])
  @@map("best_of_entries")
}

// ============================================
// GUIDE MODELS
// ============================================

model Guide {
  id              String    @id @default(cuid())
  title           String
  slug            String    @unique
  content         String?   @db.Text
  excerpt         String?   @db.Text
  introduction    String?   @db.Text
  tableOfContents Json?     @default("[]")
  featured        Boolean   @default(false)
  status          String    @default("DRAFT")
  views           Int       @default(0)
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  seoTitle        String?
  metaDescription String?

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  guideProducts GuideProduct[]

  contentBlocks Json? @default("[]")

  @@map("guides")
}

model GuideProduct {
  id        String  @id @default(cuid())
  guideId   String
  productId String
  order     Int     @default(0)
  context   String? @db.Text

  guide   Guide   @relation(fields: [guideId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([guideId, productId])
  @@map("guide_products")
}

// ============================================
// STATISTICS MODELS
// ============================================

model Statistic {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  content     String?   @db.Text
  excerpt     String?   @db.Text
  data        Json      @default("{}")
  sources     String[]  @default([])
  methodology String?   @db.Text
  embedCode   String?   @db.Text
  featured    Boolean   @default(false)
  status      String    @default("DRAFT")
  views       Int       @default(0)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  seoTitle        String?
  metaDescription String?

  nicheId String?
  niche   Niche?  @relation(fields: [nicheId], references: [id])

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  contentBlocks Json? @default("[]")

  @@map("statistics")
}

// ============================================
// AUTH MODELS
// ============================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  image         String?
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts        Account[]
  sessions        Session[]
  articles        Article[]        @relation("AuthorArticles")
  reviews         Review[]
  comparisons     Comparison[]
  bestOf          BestOf[]
  guides          Guide[]
  statistics      Statistic[]
  affiliateClicks AffiliateClick[]

  // AI Relations
  aiGenerations     AIGeneration[]
  aiContentVersions AIContentVersion[]
  aiPromptTemplates AIPromptTemplate[]
  aiUsage           AIUsage[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================
// ARTICLE MODEL
// ============================================

model Article {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  content     String?   @db.Text
  excerpt     String?   @db.Text
  status      String    @default("DRAFT")
  featured    Boolean   @default(false)
  views       Int       @default(0)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  seoTitle        String?
  metaDescription String?

  contentBlocks Json? @default("[]")

  authorId String
  author   User   @relation("AuthorArticles", fields: [authorId], references: [id])

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  @@map("articles")
}

// ============================================
// ENUMS
// ============================================

enum Role {
  ADMIN
  EDITOR
  USER
}
