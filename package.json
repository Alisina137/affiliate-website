{
  "name": "affiliate-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:pull": "prisma db pull",
    "db:studio": "prisma studio",
    "db:migrate": "prisma migrate dev",
    "seed": "npx tsx prisma/seed.ts",
    "validate:env": "npx tsx scripts/validate-env.ts",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:integration": "npx tsx scripts/test-integration.ts",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "test:e2e:headed": "npx playwright test --headed",
    "env:setup": "npx tsx scripts/setup-env.ts",
    "env:validate": "npx tsx -r dotenv/config scripts/validate-env.ts",
    "deploy:staging": "DEPLOY_ENV=staging npx tsx scripts/deploy.ts",
    "deploy:production": "DEPLOY_ENV=production npx tsx scripts/deploy.ts",
    "docker:build": "docker build -t affiliate-website .",
    "docker:run": "docker run -p 3000:3000 --env-file .env.production affiliate-website",
    "build:prod": "NODE_ENV=production npx tsx scripts/build.ts",
    "build:staging": "NODE_ENV=staging npx tsx scripts/build.ts",
    "build:analyze": "ANALYZE=true next build",
    "start:prod": "NODE_ENV=production next start",
    "health": "npx tsx scripts/monitor.ts",
    "health:watch": "npx tsx scripts/monitor.ts --watch"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@auth/prisma-adapter": "^2.11.3",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.34.0",
    "next": "16.3.3",
    "next-auth": "^5.0.0-beta.32",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "uuid": "^14.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/aws-lambda": "^8.10.162",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^2.0.0",
    "autoprefixer": "^10.5.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "prisma": "^7.10.0",
    "supertest": "^7.2.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^2.0.0"
  }
}